# --- Required ---
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
# Secret used to sign auth JWTs. The server refuses to start if this is unset.
JWT_SECRET=change_me_to_a_long_random_string

# --- Core config ---
NODE_ENV=development
PORT=3000
# Public URL of the frontend (used for CORS, password-reset links, OAuth redirect)
FRONTEND_URL=http://localhost:5173

# --- Admin bootstrap scripts (create_admin / reset_admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_admin_password

# --- Payments (optional; payment endpoints return 503 if unset) ---
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- AI features (optional; falls back to demo responses if unset) ---
OPENAI_API_KEY=
# Works with OpenAI or an OpenAI-compatible gateway such as OpenRouter.
# For OpenRouter, set the base URL and use a "provider/model" id.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email / password reset (optional) ---
EMAIL_USER=
EMAIL_PASS=
